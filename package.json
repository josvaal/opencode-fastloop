{
  "name": "opencode-fastloop",
  "version": "0.1.3",
  "description": "OpenCode plugin: instant typecheck feedback, a verify gate, and a nested-git guard for multi-repo workspaces. Includes a live TUI status chip.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    "./server": {
      "import": "./dist/index.js"
    },
    "./tui": {
      "import": "./dist/tui.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "tui",
    "typecheck",
    "feedback-loop"
  ],
  "engines": {
    "runtime": "bun"
  },
  "peerDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/solid": "*",
    "solid-js": "*"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "*",
    "@opentui/solid": "*",
    "@types/bun": "^1.4.2",
    "typescript": "^5.6.0"
  }
}
